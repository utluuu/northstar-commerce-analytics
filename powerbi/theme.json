  },
  "textClasses": {
    "title": {"fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#0F172A"},
    "header": {"fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0F172A"},
    "label": {"fontFace": "Segoe UI", "fontSize": 10, "color": "#334155"},
    "callout": {"fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#0F172A"}
  }
}
